# Models run through the local Claude Code CLI (`claude -p`, signed-in plan).
DAILY_AGENT_MODEL=claude-code:sonnet
DAILY_AGENT_HEADLINE_MODEL=claude-code:sonnet
DAILY_AGENT_COVER_MODEL=claude-code:sonnet
# Stories from followed YouTube channels, and how often channels are checked.
DAILY_AGENT_VIDEO_MODEL=claude-code:sonnet
DAILY_AGENT_VIDEO_CHECK_HOURS=3
# Stories from followed Instagram accounts. The token and user id are written
# by `daily-agent instagram connect` (docs/instagram-setup.md).
DAILY_AGENT_INSTAGRAM_MODEL=claude-code:sonnet
DAILY_AGENT_INSTAGRAM_CHECK_HOURS=3
# DAILY_AGENT_INSTAGRAM_TOKEN=
# DAILY_AGENT_INSTAGRAM_USER_ID=
# DAILY_AGENT_CLAUDE_BIN=/Users/you/.local/bin/claude

# Gemini instead (extraction and covers; see README):
# DAILY_AGENT_MODEL=google:gemini-3.8-flash
# GEMINI_API_KEY=
# ... or on Vertex AI:
# DAILY_AGENT_MODEL=google-cloud:gemini-3.8-flash
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.config/gcloud-daily-agent/application_default_credentials.json

# Local state and capture source.
DAILY_AGENT_DB_PATH=daily_agent.db
DAILY_AGENT_INSIGHTS_MARKER=insight:
# Defaults to the Claude Code transcript directory for this checkout.
# DAILY_AGENT_INSIGHTS_TRANSCRIPTS_DIR=/absolute/path/to/transcripts
# Root the timed sweep reads (every <project>/<session>.jsonl). Default ~/.claude/projects.
# DAILY_AGENT_INSIGHTS_PROJECTS_DIR=/absolute/path/to/projects

# Resurfacing cadence. Quiet hours use the computer's local time.
DAILY_AGENT_INSIGHTS_FEED_MAX_PER_RUN=2
DAILY_AGENT_FEED_QUIET_START=22
DAILY_AGENT_FEED_QUIET_END=8

# Optional direct-message health check.
DAILY_AGENT_TELEGRAM_BOT_TOKEN=
DAILY_AGENT_TELEGRAM_CHAT_ID=

# Optional per-type insight channels. Obtain API credentials from my.telegram.org,
# authorize once with `daily-agent telegram-auth`, then use `--to-telegram`.
DAILY_AGENT_TELEGRAM_API_ID=
DAILY_AGENT_TELEGRAM_API_HASH=
DAILY_AGENT_TELEGRAM_SESSION=telegram.session
DAILY_AGENT_TELEGRAM_BOT_USERNAME=
DAILY_AGENT_CHANNEL_REAP_IDLE_DAYS=30

# Local web feed (`daily-agent web`). No login: keep it on loopback. For phone
# access, relay it with `tailscale serve` (see README) instead of binding wider.
DAILY_AGENT_WEB_HOST=127.0.0.1
DAILY_AGENT_WEB_PORT=8765
DAILY_AGENT_WEB_PAGE_SIZE=20
# Extra host names to answer to: your Mac's tailnet names when using `tailscale serve`.
# DAILY_AGENT_WEB_ALLOWED_HOSTS=my-mac.tailnet-name.ts.net,my-mac,100.x.y.z
# Write stories for followed YouTube channels and Instagram accounts in the
# background (else: `videos sync` / `instagram sync`).
DAILY_AGENT_WEB_VIDEO_SYNC=true
