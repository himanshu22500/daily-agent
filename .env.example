# Copy to .env and fill in. All daily-agent settings are prefixed DAILY_AGENT_.

# --- LLM (provider-agnostic: "provider:model-name") ---
# Examples:
#   anthropic:claude-sonnet-4-5
#   openai:gpt-4o
#   google-gla:gemini-2.0-flash
# OpenAI codex / gpt-5 reasoning models use the Responses API — use the
# "openai-responses:" prefix for those:
#   openai-responses:gpt-5-codex
#   openai-responses:codex-mini-latest
DAILY_AGENT_MODEL=openai-responses:gpt-5-codex

# Provider API key — set the one matching your model above:
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- GitHub ---
# A token (classic or fine-grained) with read access to the org's repos.
DAILY_AGENT_GITHUB_TOKEN=
DAILY_AGENT_GITHUB_ORG=your-org
# Optional: only watch these repos (comma-separated). Empty = all org repos.
DAILY_AGENT_GITHUB_REPOS=
# Skip repos with no pushes in this many days.
DAILY_AGENT_GITHUB_ACTIVE_WITHIN_DAYS=30

# --- Collection ---
DAILY_AGENT_LOOKBACK_DAYS=1
DAILY_AGENT_DB_PATH=daily_agent.db

# --- Outline (engineering docs) ---
# Enables the `docs` / `howto` commands and doc-grounded deep dives.
DAILY_AGENT_OUTLINE_URL=
DAILY_AGENT_OUTLINE_TOKEN=

# --- GitHub Projects (v2 board — the org's PM, feeds the initiative model) ---
# The project number from its URL: …/orgs/<org>/projects/<NUMBER>.
DAILY_AGENT_GITHUB_PROJECT_NUMBER=
# Owner of the project; leave empty to use DAILY_AGENT_GITHUB_ORG.
# DAILY_AGENT_GITHUB_PROJECT_OWNER=
# Projects v2 needs the read:project scope. If DAILY_AGENT_GITHUB_TOKEN lacks it,
# set a dedicated project-scoped token here:
# DAILY_AGENT_GITHUB_PROJECT_TOKEN=

# --- Team identity mapping (for `brief` and `brief --assignee me`) ---
# Copy team.example.json to team.json (gitignored — it holds names/handles).
# DAILY_AGENT_TEAM_PATH=team.json
# Canonical name that "me" resolves to:
DAILY_AGENT_ME=

# --- Response cache ---
# Terminal entities (merged PRs) cache forever; everything else uses these TTLs
# (seconds). Docs change rarely -> long TTL.
# DAILY_AGENT_CACHE_ENABLED=true
# DAILY_AGENT_GITHUB_CACHE_TTL=600
# DAILY_AGENT_PROJECTS_CACHE_TTL=600
# DAILY_AGENT_OUTLINE_CACHE_TTL=604800

# Optional: cheaper/faster model for bulk synthesis (summary + per-person briefs).
# Leave empty to use DAILY_AGENT_MODEL. e.g. anthropic:claude-haiku-4-5
# DAILY_AGENT_FAST_MODEL=

# --- Slack delivery (the `feed --to-slack` channel) ---
# 1. Create a Slack app (https://api.slack.com/apps -> From scratch).
# 2. OAuth & Permissions -> Bot Token Scopes -> add `chat:write`.
# 3. Install to your workspace; copy the "Bot User OAuth Token" (xoxb-...).
# 4. Destination = your Slack user ID to DM you (Profile -> ... -> Copy member
#    ID, looks like U0123ABCD), or a channel ID to post to a channel.
# 5. Verify with: daily-agent slack-check
# DAILY_AGENT_SLACK_BOT_TOKEN=xoxb-...
# DAILY_AGENT_SLACK_DESTINATION=U0123ABCD

# --- Telegram delivery (the `feed --to-telegram` channel; no admin approval) ---
# 1. Message @BotFather -> /newbot -> name it -> copy the bot token.
# 2. Open your new bot in Telegram and press Start (send /start) so it may DM you.
# 3. Message @userinfobot to get your numeric chat ID (or call getUpdates).
# 4. Verify with: daily-agent telegram-check
# DAILY_AGENT_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# DAILY_AGENT_TELEGRAM_CHAT_ID=42

# --- Default feed channel ---
# Which channel `feed` (and scheduled runs) use when no --to-* flag is passed.
# console (default) | telegram | slack | file. Set to telegram to push by default.
# DAILY_AGENT_FEED_CHANNEL=telegram

# --- Multi-stream Telegram (auto-create a channel per notification type) ---
# Routes each notification type (org-activity, insights, …) to its own Telegram
# channel that the tool creates/deletes itself. Bots can't create channels, so
# this uses an MTProto user-client (your account) to provision; the bot posts.
# Setup:
#   1. uv sync --extra telegram        (installs telethon)
#   2. my.telegram.org -> API development tools -> create an app -> copy api_id + api_hash
#   3. ! uv run daily-agent telegram-auth   (one-time phone login -> session file)
#   4. DAILY_AGENT_FEED_MULTI_STREAM=true   (+ DAILY_AGENT_FEED_CHANNEL=telegram)
# The session file IS your account login — it's gitignored; never commit it / put it in CI.
# DAILY_AGENT_TELEGRAM_API_ID=1234567
# DAILY_AGENT_TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
# DAILY_AGENT_TELEGRAM_BOT_USERNAME=himanshu_daily_agent_bot
# DAILY_AGENT_TELEGRAM_SESSION=telegram.session
# DAILY_AGENT_FEED_MULTI_STREAM=false
# `telegram-reap` deletes channels unused this many days:
# DAILY_AGENT_CHANNEL_REAP_IDLE_DAYS=30

# --- Feed cadence (pacer) ---
# Max chapters delivered per `feed` run; run feed periodically (e.g. hourly via
# scripts/install-feed-launchd.sh) so the backlog trickles instead of flooding.
# DAILY_AGENT_FEED_MAX_PER_RUN=3
# Quiet hours [start, end) on a 24h local clock (may wrap midnight); no delivery
# in this window. Set both equal to disable quiet hours.
# DAILY_AGENT_FEED_QUIET_START=22
# DAILY_AGENT_FEED_QUIET_END=8
